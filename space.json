 about a month ago from Kvaløya in northern Norway.","img":"https://assets.science.nasa.gov/content/dam/science/cds/apod/apod/2026/november/GalaxyVsAurora_Scheib_960.jpg","by":"Guillaume Scheib","video":false},"tle":["1 25544U 98067A   26321.33455779  .00009779  00000+0  18259-3 0  9996","2 25544  51.6318 262.2236 0007381  35.3953 324.7525 15.49430950595496"],"passes":[{"start":"2026-11-17T17:34:23Z","end":"2026-11-17T17:39:02Z","top":"2026-11-17T17:37:35Z","max":45,"from":["SW","西南"],"to":["E","東"],"mins":5},{"start":"2026-11-17T19:10:55Z","end":"2026-11-17T19:11:59Z","top":"2026-11-17T19:14:16Z","max":89,"from":["W","西"],"to":["W","西"],"mins":1},{"start":"2026-11-18T16:46:47Z","end":"2026-11-18T16:52:53Z","top":"2026-11-18T16:49:49Z","max":33,"from":["SW","西南"],"to":["E","東"],"mins":6},{"start":"2026-11-18T18:23:03Z","end":"2026-11-18T18:25:53Z","top":"2026-11-18T18:26:24Z","max":84,"from":["W","西"],"to":["W","西"],"mins":3},{"start":"2026-11-19T17:35:12Z","end":"2026-11-19T17:39:46Z","top":"2026-11-19T17:38:32Z","max":73,"from":["W","西"],"to":["E","東"],"mins":5},{"start":"2026-11-19T19:11:57Z","end":"2026-11-19T19:13:01Z","top":"2026-11-19T19:15:19Z","max":89,"from":["W","西"],"to":["W","西"],"mins":1},{"start":"2026-11-20T16:47:22Z","end":"2026-11-20T16:53:58Z","top":"2026-11-20T16:50:40Z","max":58,"from":["SW","西南"],"to":["E","東"],"mins":7},{"start":"2026-11-20T18:24:03Z","end":"2026-11-20T18:26:53Z","top":"2026-11-20T18:27:24Z","max":87,"from":["W","西"],"to":["W","西"],"mins":3}],"track":{"t0":"2026-11-17T16:20:00Z","step":60,"p":[[36.1,103.7],[33.5,107.0],[30.9,110.1],[28.2,113.1],[25.4,115.8],[22.5,118.5],[19.6,121.0],[16.7,123.4],[13.7,125.7],[10.7,128.0],[7.6,130.2],[4.6,132.4],[1.5,134.5],[-1.5,136.7],[-4.6,138.8],[-7.6,141.0],[-10.6,143.2],[-13.6,145.5],[-16.6,147.8],[-19.6,150.2],[-22.5,152.7],[-25.3,155.3],[-28.1,158.1],[-30.8,161.0],[-33.5,164.0],[-36.0,167.3],[-38.4,170.9],[-40.7,174.6],[-42.9,178.7],[-44.9,-177.0],[-46.7,-172.3],[-48.2,-167.4],[-49.5,-1