 Moon.","img":"https://assets.science.nasa.gov/dynamicimage/assets/science/cds/apod/apod/2026/november/a17anaglyph_vanMeijgaarden_f.jpg?w=1400&fit=clip","by":"Gene Cernan, Apollo 17, NASA; Anaglyph by Erik van Meijgaarden","video":false},"tle":["1 25544U 98067A   26332.04031741  .00004674  00000+0  90938-4 0  9999","2 25544  51.6312 209.2135 0007395  72.8625 287.3173 15.49639368597158"],"passes":[{"start":"2026-11-28T16:50:27Z","end":"2026-11-28T16:57:00Z","top":"2026-11-28T16:53:44Z","max":56,"from":["W","西"],"to":["SE","東南"],"mins":7},{"start":"2026-11-28T18:27:51Z","end":"2026-11-28T18:31:22Z","top":"2026-11-28T18:30:00Z","max":16,"from":["W","西"],"to":["S","南"],"mins":4},{"start":"2026-11-29T17:39:26Z","end":"2026-11-29T17:44:50Z","top":"2026-11-29T17:42:08Z","max":23,"from":["W","西"],"to":["S","南"],"mins":5},{"start":"2026-11-30T16:51:12Z","end":"2026-11-30T16:57:13Z","top":"2026-11-30T16:54:13Z","max":31,"from":["W","西"],"to":["SE","東南"],"mins":6},{"start":"2026-12-01T17:41:17Z","end":"2026-12-01T17:43:26Z","top":"2026-12-01T17:42:21Z","max":11,"from":["SW","西南"],"to":["SW","西南"],"mins":2},{"start":"2026-12-02T16:52:19Z","end":"2026-12-02T16:56:42Z","top":"2026-12-02T16:54:30Z","max":17,"from":["W","西"],"to":["S","南"],"mins":4}],"track":{"t0":"2026-11-28T13:28:00Z","step":60,"p":[[21.2,-45.1],[24.1,-42.5],[26.9,-39.8],[29.7,-36.9],[32.4,-33.9],[35.0,-30.7],[37.5,-27.2],[39.8,-23.6],[42.1,-19.6],[44.1,-15.3],[46.0,-10.8],[47.6,-5.9],[49.1,-0.7],[50.2,4.7],[51.0,10.4],[51.6,16.3],[51.8,22.3],[51.7,28.3],[51.2,34.2],[50.4,40.0],[49.4,45.5],[48.0,50.8],[46.4,55.7],[44.6,60.4],[42.6,64.7],[40.4,68.7],[38.1,72.5],[35.6,76.0],[33.1,79.2],[30.4,82.3],[27.6,85.2],[24.8,87.9],[22.0,90.5],[19.0,93.0],[16.1,95.4],[13.1,97.7],[10.1,100.0],[7.0,102.2],[4.0,104.4],[0.9,106.5],[-2.1,108.7],[-5.2,110.8],[-8.2,113.0],[-11.3,115.3],[-14.3,117.5],[-17.2,119.9],[-20.2,122.3],[-23.1,124.8],[-25.9,127.5],[-28.7,130.2],[-31.4,133.2],[-34.0,136.3],[-36.5,139.6],[-38.9,143.2],[-41.2,14