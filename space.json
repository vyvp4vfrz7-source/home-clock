 about a month ago from Kvaløya in northern Norway.","img":"https://assets.science.nasa.gov/content/dam/science/cds/apod/apod/2026/november/GalaxyVsAurora_Scheib_960.jpg","by":"Guillaume Scheib","video":false},"tle":["1 25544U 98067A   26321.20556304  .00009453  00000+0  17680-3 0  9994","2 25544  51.6317 262.8623 0007378  34.8927 325.2544 15.49427836595476"],"passes":[{"start":"2026-11-17T17:34:23Z","end":"2026-11-17T17:39:02Z","top":"2026-11-17T17:37:35Z","max":45,"from":["SW","西南"],"to":["E","東"],"mins":5},{"start":"2026-11-17T19:10:55Z","end":"2026-11-17T19:11:59Z","top":"2026-11-17T19:14:16Z","max":89,"from":["W","西"],"to":["W","西"],"mins":1},{"start":"2026-11-18T16:46:47Z","end":"2026-11-18T16:52:53Z","top":"2026-11-18T16:49:50Z","max":33,"from":["SW","西南"],"to":["E","東"],"mins":6},{"start":"2026-11-18T18:23:03Z","end":"2026-11-18T18:25:53Z","top":"2026-11-18T18:26:24Z","max":84,"from":["W","西"],"to":["W","西"],"mins":3},{"start":"2026-11-19T17:35:12Z","end":"2026-11-19T17:39:46Z","top":"2026-11-19T17:38:32Z","max":73,"from":["W","西"],"to":["E","東"],"mins":5},{"start":"2026-11-19T19:11:58Z","end":"2026-11-19T19:13:01Z","top":"2026-11-19T19:15:19Z","max":89,"from":["W","西"],"to":["W","西"],"mins":1},{"start":"2026-11-20T16:47:23Z","end":"2026-11-20T16:53:58Z","top":"2026-11-20T16:50:40Z","max":58,"from":["SW","西南"],"to":["E","東"],"mins":7},{"start":"2026-11-20T18:24:03Z","end":"2026-11-20T18:26:53Z","top":"2026-11-20T18:27:24Z","max":87,"from":["W","西"],"to":["W","西"],"mins":3}],"track":{"t0":"2026-11-17T13:39:00Z","step":60,"p":[[-35.4,-146.3],[-37.9,-142.8],[-40.2,-139.1],[-42.4,-135.2],[-44.4,-130.9],[-46.2,-126.3],[-47.8,-121.4],[-49.2,-116.3],[-50.3,-110.8],[-51.1,-105.1],[-51.6,-99.2],[-51.8,-93.3],[-51.6,-87.3],[-51.2,-81.4],[-50.4,-75.7],[-49.3,-70.3],[-47.9,-65.1],[-46.3,-60.2],[-44.5,-55.6],[-42.5,-51.3],[-40.3,-47.3],[-38.0,-43.6],[-35.5,-40.1],[-32.9,-36.8],[-30.3,-33.8],[-27.5,-30.9],[-24.7,-28.2],[-21.9,-25.6],[-18.9,-23.1],[-16.0,-20.7],[-13.0,-18.