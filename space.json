 Moon.","img":"https://assets.science.nasa.gov/dynamicimage/assets/science/cds/apod/apod/2026/november/a17anaglyph_vanMeijgaarden_f.jpg?w=1400&fit=clip","by":"Gene Cernan, Apollo 17, NASA; Anaglyph by Erik van Meijgaarden","video":false},"tle":["1 25544U 98067A   26331.91134031  .00003140  00000+0  63767-4 0  9997","2 25544  51.6314 209.8520 0007387  72.3375 287.8420 15.49635013597133"],"passes":[{"start":"2026-11-28T16:50:27Z","end":"2026-11-28T16:57:01Z","top":"2026-11-28T16:53:44Z","max":56,"from":["W","西"],"to":["SE","東南"],"mins":7},{"start":"2026-11-28T18:27:51Z","end":"2026-11-28T18:31:22Z","top":"2026-11-28T18:30:00Z","max":16,"from":["W","西"],"to":["S","南"],"mins":4},{"start":"2026-11-29T17:39:27Z","end":"2026-11-29T17:44:50Z","top":"2026-11-29T17:42:09Z","max":23,"from":["W","西"],"to":["S","南"],"mins":5},{"start":"2026-11-30T16:51:13Z","end":"2026-11-30T16:57:14Z","top":"2026-11-30T16:54:14Z","max":31,"from":["W","西"],"to":["SE","東南"],"mins":6},{"start":"2026-12-01T17:41:19Z","end":"2026-12-01T17:43:27Z","top":"2026-12-01T17:42:23Z","max":11,"from":["SW","西南"],"to":["SW","西南"],"mins":2},{"start":"2026-12-02T16:52:22Z","end":"2026-12-02T16:56:45Z","top":"2026-12-02T16:54:33Z","max":16,"from":["W","西"],"to":["S","南"],"mins":4}],"track":{"t0":"2026-11-28T07:40:00Z","step":60,"p":[[43.7,156.7],[41.6,160.9],[39.4,164.8],[37.0,168.5],[34.5,171.9],[31.9,175.0],[29.2,178.0],[26.4,-179.2],[23.5,-176.5],[20.6,-173.9],[17.7,-171.5],[14.7,-169.1],[11.7,-166.8],[8.7,-164.6],[5.7,-162.4],[2.6,-160.3],[-0.5,-158.1],[-3.5,-155.9],[-6.6,-153.8],[-9.6,-151.6],[-12.6,-149.3],[-15.6,-147.0],[-18.6,-144.7],[-21.5,-142.2],[-24.4,-139.6],[-27.2,-136.9],[-29.9,-134.1],[-32.6,-131.0],[-35.2,-127.8],[-37.6,-124.4],[-40.0,-120.7],[-42.2,-116.8],[-44.2,-112.5],[-46.1,-108.0],[-47.7,-103.1],[-49.1,-98.0],[-50.2,-92.5],[-51.1,-86.8],[-51.6,-81.0],[-51.8,-75.0],[-51.7,-69.1],[-51.2,-63.2],[-50.4,-57.5],[-49.4,-52.0],[-48.1,-46.8],[-46.5,-41.8],[-44.7,-37.2],[-42.7,-32.9],[-40.5,-28.9],[-