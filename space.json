F1260000CCAM02081M_.JPG","at":"2026-11-21T18:47:49","link":"/raw_images/1657271"},{"rover":"Perseverance","zh":"毅力號","sol":2031,"cam":"SuperCam zoom","camZh":"超級相機","src":"https://mars.nasa.gov/mars2020-raw-images/pub/ods/surface/sol/02031/ids/edr/browse/scam/LRF_2031_0847235763_228EBY_N0930000SCAM01031_0010I4J01_1200.jpg","at":"2026-11-06T11:41:23","link":"https://mars.nasa.gov/mars2020/multimedia/raw-images/LRF_2031_0847235763_228EBY_N0930000SCAM01031_0010I4J"},{"rover":"Perseverance","zh":"毅力號","sol":2031,"cam":"SuperCam zoom","camZh":"超級相機","src":"https://mars.nasa.gov/mars2020-raw-images/pub/ods/surface/sol/02031/ids/edr/browse/scam/LRF_2031_0847236596_261EBY_N0930000SCAM01031_0050I4J01_1200.jpg","at":"2026-11-06T11:55:16","link":"https://mars.nasa.gov/mars2020/multimedia/raw-images/LRF_2031_0847236596_261EBY_N0930000SCAM01031_0050I4J"},{"rover":"Curiosity","zh":"好奇號","sol":5081,"cam":"ChemCam zoom","camZh":"化學相機","src":"https://mars.nasa.gov/msl-raw-images/proj/msl/redops/ods/surface/sol/05081/opgs/edr/ccam/CR0_848555213EDR_F1260000CCAM02081M_.JPG","at":"2026-11-21T19:00:02","link":"/raw_images/1657272"},{"rover":"Perseverance","zh":"毅力號","sol":2031,"cam":"SuperCam zoom","camZh":"超級相機","src":"https://mars.nasa.gov/mars2020-raw-images/pub/ods/surface/sol/02031/ids/edr/browse/scam/LRF_2031_0847237865_241EBY_N0930000SCAM01031_0100I4J01_1200.jpg","at":"2026-11-06T12:16:25","link":"https://mars.nasa.gov/mars2020/multimedia/raw-images/LRF_2031_0847237865_241EBY_N0930000SCAM01031_0100I4J"}],"apod":{"date":"2026-11-21","title":"Voyager's Neptune","text":"Cruising through the outer solar system, the Voyager 2 spacecraft made its closest approach to Neptune on August 25, 1989, the only spacecraft to visit the most distant ice giant planet. Based on the images recorded during its close encounter and in the following days, this inspired composited scene covers the dim outer planet, largest moon Triton, and faint system of rings. From just beyond Neptune's orbit, the interplanetary perspective looks back toward the Sun, capturing the planet and Triton as thin sunlit crescents. Cirrus clouds and a dark band circle Neptune's south polar region, with a cloudy vortex above the pole itself. Parts of the very faint ring system along with the three bright ring arcs were first imaged by Voyager during the fly-by, though the faintest segments are modeled in this composited picture. Spanning 7.5 degrees, the background starfield is composed from sky survey data centered on the constellation Camelopardalis, corresponding to the outbound Voyager's view of the magnificent Neptunian system. Still cruising in 2026, the Voyager 2 spacecraft is now in interstellar space.","img":"https://assets.science.nasa.gov/dynamicimage/assets/science/cds/apod/apod/2026/november/Neptune-South-Pole-Voyager-2_2327x1670.jpg?w=1400&fit=clip","by":"Assembly/Processing - Rolf Olsen, Data - Voyager 2, NASA Planetary Data System","video":false},"tle":["1 25544U 98067A   26325.78470666  .00010099  00000+0  18759-3 0  9993","2 25544  51.6319 240.1895 0007379  51.3703 308.7945 15.49538290596182"],"passes":[{"start":"2026-11-22T16:48:07Z","end":"2026-11-22T16:54:49Z","top":"2026-11-22T16:51:28Z","max":84,"from":["W","西"],"to":["E","東"],"mins":7},{"start":"2026-11-22T18:24:55Z","end":"2026-11-22T18:27:44Z","top":"2026-11-22T18:28:16Z","max":81,"from":["W","西"],"to":["W","西"],"mins":3},{"start":"2026-11-23T17:36:56Z","end":"2026-11-23T17:41:31Z","top":"2026-11-23T17:40:17Z","max":90,"from":["W","西"],"to":["E","東"],"mins":5},{"start":"2026-11-23T19:13:45Z","end":"2026-11-23T19:14:27Z","top":"2026-11-23T19:16:56Z","max":41,"from":["W","西"],"to":["W","西"],"mins":1},{"start":"2026-11-24T16:48:56Z","end":"2026-11-24T16:55:38Z","top":"2026-11-24T16:52:17Z","max":87,"from":["W","西"],"to":["E","東"],"mins":7},{"start":"2026-11-24T18:25:43Z","end":"2026-11-24T18:28:38Z","top":"2026-11-24T18:29:00Z","max":55,"from":["W","西"],"to":["SW","西南"],"mins":3},{"start":"2026-11-25T17:37:42Z","end"