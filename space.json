1200.jpg","at":"2026-11-06T11:41:23","link":"https://mars.nasa.gov/mars2020/multimedia/raw-images/LRF_2031_0847235763_228EBY_N0930000SCAM01031_0010I4J"},{"rover":"Perseverance","zh":"毅力號","sol":2031,"cam":"SuperCam zoom","camZh":"超級相機","src":"https://mars.nasa.gov/mars2020-raw-images/pub/ods/surface/sol/02031/ids/edr/browse/scam/LRF_2031_0847236596_261EBY_N0930000SCAM01031_0050I4J01_1200.jpg","at":"2026-11-06T11:55:16","link":"https://mars.nasa.gov/mars2020/multimedia/raw-images/LRF_2031_0847236596_261EBY_N0930000SCAM01031_0050I4J"},{"rover":"Perseverance","zh":"毅力號","sol":2031,"cam":"SuperCam zoom","camZh":"超級相機","src":"https://mars.nasa.gov/mars2020-raw-images/pub/ods/surface/sol/02031/ids/edr/browse/scam/LRF_2031_0847237865_241EBY_N0930000SCAM01031_0100I4J01_1200.jpg","at":"2026-11-06T12:16:25","link":"https://mars.nasa.gov/mars2020/multimedia/raw-images/LRF_2031_0847237865_241EBY_N0930000SCAM01031_0100I4J"}],"apod":{"date":"2026-11-19","title":"The Horsehead and Flame Nebulas","text":"Today's image could have been a painting. But what do these colors mean? The brightest star, left of the center, is blue Alnitak (the Girdle): a triple star system best known for being the easternmost star in Orion's Belt. The instantly recognizable shape of a dark horse's head at the center is the aptly named Horsehead Nebula. It is about five light-years tall and lies approximately 1,500 light-years away. It is made of dust and gas that obscure the red glow behind it, which is caused by hydrogen gas being ionized by the bright star Sigma Orionis at the top. The orange nebula with dark filaments on the left is the Flame Nebula. Closer to the Horsehead, the blue reflection nebula NGC 2023 is actively forming stars. The data for this \"painting\" were collected for almost six hours at the Utah Desert Remote Observatories, but the equipment was remotely controlled by the astrophotographer from his home, over 2,000 km away in Illinois.","img":"https://assets.science.nasa.gov/dynamicimage/assets/science/cds/apod/apod/2026/november/Horsehead_Nebula_Killion.jpg?w=1400&fit=clip","by":"Mark E. Killion","video":false},"tle":["1 25544U 98067A   26323.26944509  .00013909  00000+0  25567-3 0  9994","2 25544  51.6317 252.6441 0007410  42.3196 317.8363 15.49482233595793"],"passes":[{"start":"2026-11-20T16:47:21Z","end":"2026-11-20T16:53:56Z","top":"2026-11-20T16:50:38Z","max":58,"from":["SW","西南"],"to":["E","東"],"mins":7},{"start":"2026-11-20T18:24:01Z","end":"2026-11-20T18:26:51Z","top":"2026-11-20T18:27:22Z","max":87,"from":["W","西"],"to":["W","西"],"mins":3},{"start":"2026-11-21T17:36:04Z","end":"2026-11-21T17:40:39Z","top":"2026-11-21T17:39:25Z","max":89,"from":["W","西"],"to":["E","東"],"mins":5},{"start":"2026-11-21T19:12:51Z","end":"2026-11-21T19:13:35Z","top":"2026-11-21T19:16:11Z","max":68,"from":["W","西"],"to":["W","西"],"mins":1},{"start":"2026-11-22T16:48:05Z","end":"2026-11-22T16:54:47Z","top":"2026-11-22T16:51:26Z","max":84,"from":["W","西"],"to":["E","東"],"mins":7},{"start":"2026-11-22T18:24:52Z","end":"2026-11-22T18:27:42Z","top":"2026-11-22T18:28:13Z","max":81,"from":["W","西"],"to":["W","西"],"mins":3},{"start":"2026-11-23T17:36:52Z","end":"2026-11-23T17:41:28Z","top":"2026-11-23T17:40:13Z","max":90,"from":["W","西"],"to":["E","東"],"mins":5},{"start":"2026-11-23T19:13:41Z","end":"2026-11-23T19:14:23Z","top":"2026-11-23T19:16:52Z","max":41,"from":["W","西"],"to":["W","西"],"mins":1}],"track":{"t0":"2026-11-19T22:12:00Z","step":60,"p":[[42.6,-96.2],[44.6,-91.9],[46.4,-87.3],[48.0,-82.3],[49.4,-77.1],[50.4,-71.5],[51.2,-65.8],[51.7,-59.9],[51.8,-53.9],[51.6,-47.9],[51.1,-42.0],[50.2,-36.3],[49.1,-30.8],[47.7,-25.7],[46.0,-20.8],[44.2,-16.2],[42.1,-12.0],[39.9,-8.0],[37.5,-4.3],[35.0,-0.9],[32.4,2.3],[29.8,5.4],[27.0,8.2],[24.2,10.9],[21.3,13.5],[18.4,15.9],[15.4,18.3],[12.4,20.6],[9.4,22.9],[6.3,25.1],[3.3,27.2],[0.2,29.4],[-2.8,31.5],[-5.9,33.7],[-8.9,35.9],[-11.9,38.1],[-14.9,40.4],[-17.9,42.8],[-20.8,45.2],[-23.7,47.7],[-26.5,50.4],[-29.3,53.2],[-3