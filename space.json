r":"Perseverance","zh":"毅力號","sol":2031,"cam":"SuperCam zoom","camZh":"超級相機","src":"https://mars.nasa.gov/mars2020-raw-images/pub/ods/surface/sol/02031/ids/edr/browse/scam/LRF_2031_0847235763_228EBY_N0930000SCAM01031_0010I4J01_1200.jpg","at":"2026-11-06T11:41:23","link":"https://mars.nasa.gov/mars2020/multimedia/raw-images/LRF_2031_0847235763_228EBY_N0930000SCAM01031_0010I4J"},{"rover":"Perseverance","zh":"毅力號","sol":2031,"cam":"SuperCam zoom","camZh":"超級相機","src":"https://mars.nasa.gov/mars2020-raw-images/pub/ods/surface/sol/02031/ids/edr/browse/scam/LRF_2031_0847236596_261EBY_N0930000SCAM01031_0050I4J01_1200.jpg","at":"2026-11-06T11:55:16","link":"https://mars.nasa.gov/mars2020/multimedia/raw-images/LRF_2031_0847236596_261EBY_N0930000SCAM01031_0050I4J"},{"rover":"Perseverance","zh":"毅力號","sol":2031,"cam":"SuperCam zoom","camZh":"超級相機","src":"https://mars.nasa.gov/mars2020-raw-images/pub/ods/surface/sol/02031/ids/edr/browse/scam/LRF_2031_0847237865_241EBY_N0930000SCAM01031_0100I4J01_1200.jpg","at":"2026-11-06T12:16:25","link":"https://mars.nasa.gov/mars2020/multimedia/raw-images/LRF_2031_0847237865_241EBY_N0930000SCAM01031_0100I4J"}],"apod":{"date":"2026-11-25","title":"SPHEREx Seeing Through Dust","text":"What is blocking the center of the Milky Way? During its 13 billion years, our Milky Way has collected a lot of dust. In contrast to the skin cells, dirt, pollen, and other debris that make up the dust behind your couch, cosmic dust is hundreds of times smaller and made of tiny compounds of oxygen, carbon, and other elements released into space when a star dies. Today’s video shows infrared light from the Milky Way’s center gathered by NASA’s SPHEREx satellite. Each false color in the video corresponds to the infrared color associated with the wavelength shown in the top left. In the near-infrared, like 1.2 microns, light gets absorbed and scatters off of dust particles. SPHEREx then sees the Galactic Center almost entirely blocked by clouds of dust. In the mid-infrared, though, light is able to pierce through the dust and reach SPHEREx. This is similar to, but not exactly, why sunsets are red !","img":"https://assets.science.nasa.gov/dynamicimage/assets/science/cds/apod/apod/2026/november/spherex_1.2micron.png?w=1400&fit=clip","by":"","video":false},"tle":["1 25544U 98067A   26329.13827948  .00005332  00000+0  10279-3 0  9998","2 25544  51.6318 223.5844 0007440  62.9833 297.1915 15.49581308596705"],"passes":[{"start":"2026-11-26T16:49:45Z","end":"2026-11-26T16:56:27Z","top":"2026-11-26T16:53:06Z","max":82,"from":["W","西"],"to":["E","東"],"mins":7},{"start":"2026-11-26T18:26:38Z","end":"2026-11-26T18:29:38Z","top":"2026-11-26T18:29:38Z","max":31,"from":["W","西"],"to":["SW","西南"],"mins":3},{"start":"2026-11-27T17:38:33Z","end":"2026-11-27T17:43:51Z","top":"2026-11-27T17:41:44Z","max":42,"from":["W","西"],"to":["SE","東南"],"mins":5},{"start":"2026-11-27T19:16:56Z","end":"2026-11-27T19:16:56Z","top":"2026-11-27T19:17:50Z","max":11,"from":["SW","西南"],"to":["SW","西南"],"mins":1},{"start":"2026-11-28T16:50:30Z","end":"2026-11-28T16:57:03Z","top":"2026-11-28T16:53:47Z","max":56,"from":["W","西"],"to":["SE","東南"],"mins":7},{"start":"2026-11-28T18:27:54Z","end":"2026-11-28T18:31:25Z","top":"2026-11-28T18:30:03Z","max":16,"from":["W","西"],"to":["S","南"],"mins":4},{"start":"2026-11-29T17:39:31Z","end":"2026-11-29T17:44:54Z","top":"2026-11-29T17:42:12Z","max":23,"from":["W","西"],"to":["S","南"],"mins":5},{"start":"2026-11-30T16:51:18Z","end":"2026-11-30T16:57:19Z","top":"2026-11-30T16:54:18Z","max":31,"from":["W","西"],"to":["SE","東南"],"mins":6}],"track":{"t0":"2026-11-26T01:47:00Z","step":60,"p":[[-4.3,-49.4],[-7.3,-47.3],[-10.4,-45.0],[-13.4,-42.8],[-16.4,-40.5],[-19.3,-38.1],[-22.2,-35.6],[-25.1,-33.0],[-27.9,-30.2],[-30.6,-27.4],[-33.2,-24.3],[-35.8,-21.0],[-38.2,-17.5],[-40.6,-13.8],[-42.7,-9.8],[-44.7,-5.4],[-46.5,-0.8],[-48.1,4.1],[-49.4,9.3],[-50.5,14.8],[-51.2,20.6],[-51.7,26.5],[-51.8,32.4],[-51.6,38.4],[-51.0,44.2],[-50.2,49.9],[-4